# VRChat asks API clients to identify themselves. Include a real operator contact.
VRCHAT_USER_AGENT="VRCX-Web/0.1.0 (contact@example.com)"

# Set this to false only for trusted-network deployments that cannot provide HTTPS.
VRCHAT_COOKIE_SECURE=true

# MongoDB is the only authoritative durable store. Use a dedicated database
# and keep it reachable only by this application server.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="vrcx"

# Generate exactly 32 random bytes and encode them as base64. Changing this
# value makes an existing persisted VRChat session unreadable.
VRCHAT_SESSION_ENCRYPTION_KEY="replace-with-32-random-bytes-encoded-as-base64"
